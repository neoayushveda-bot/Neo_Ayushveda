// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  sku               String         @unique
  description       String         @default("")
  shortDescription  String         @default("")
  price             Float          @default(0)
  compareAtPrice    Float?
  costPrice         Float?
  currency          String         @default("INR")
  stock             Int            @default(0)
  lowStockThreshold Int            @default(10)
  trackInventory    Boolean        @default(true)
  allowBackorders   Boolean        @default(false)
  status            String         @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  featured          Boolean        @default(false)
  views             Int            @default(0)
  unitsSold         Int            @default(0)
  revenue           Float          @default(0)
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  tags              String         @default("") // comma-separated
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String     @default("")
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerEmail   String
  customerPhone   String   @default("")
  items           String   @default("[]") // JSON string
  subtotal        Float    @default(0)
  tax             Float    @default(0)
  discount        Float    @default(0)
  total           Float    @default(0)
  paymentStatus   String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  orderStatus     String   @default("PENDING") // PENDING | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  shippingAddress String   @default("")
  billingAddress  String   @default("")
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String   @default("")
  company    String   @default("")
  country    String   @default("")
  totalSpent Float    @default(0)
  orderCount Int      @default(0)
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

